# =============================================================================
#  OmMail AI — environment configuration
#
#  Copy this file to `.env.local` (local development) and paste the same
#  variables into Vercel → Project → Settings → Environment Variables.
#
#  ⚠  `.env.local` is git-ignored. Never commit real keys, and never put them
#     in `public/` — the dashboard is served to the browser.
#
#  Generate the two secrets you own yourself:
#      openssl rand -hex 32
# =============================================================================

# -----------------------------------------------------------------------------
#  DeoMail — https://deomail.com/app/settings → API Keys → create a key
#  Permissions needed: send (reply) + read (fetch the full message).
# -----------------------------------------------------------------------------
DEOMAIL_API_KEY=
DEOMAIL_BASE_URL=https://api.deomail.com/v1
DEOMAIL_SENDER=support@omhackz.top

# -----------------------------------------------------------------------------
#  Webhook authentication — the shared secret DeoMail Fire sends with every
#  event. Fire → Automations → action "Webhook (HTTP)" → Authentication:
#  API Key, Key Name = X-Webhook-Secret, Location = Header.
#  Generate: openssl rand -hex 32
# -----------------------------------------------------------------------------
WEBHOOK_SECRET=
WEBHOOK_SECRET_HEADER=X-Webhook-Secret
WEBHOOK_ALLOW_QUERY_SECRET=false
WEBHOOK_SECRET_QUERY_PARAM=secret
# Fire has no documented request signature, so HMAC verification stays off.
# The verifier is ready in case DeoMail adds one.
WEBHOOK_SIGNATURE_ENABLED=false
WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature

# -----------------------------------------------------------------------------
#  Agnes AI — https://agnes-ai.com → developer dashboard → API keys
#  OpenAI-compatible gateway: https://apihub.agnes-ai.com/v1/chat/completions
# -----------------------------------------------------------------------------
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash
AGNES_TEMPERATURE=0.5
AGNES_MAX_TOKENS=500
AGNES_TIMEOUT_MS=25000
AGNES_MAX_RETRIES=2

# -----------------------------------------------------------------------------
#  Application
# -----------------------------------------------------------------------------
# draft = every reply waits for approval · automatic = sends on its own
#        disabled = records mail, sends nothing
AUTO_REPLY_MODE=draft
# Fire payload profile: canonical (DeoMail's Zapier-style template) or extended
DEOMAIL_WEBHOOK_PROFILE=canonical
APP_NAME=OmMail AI
APP_URL=https://mailbot.omhackz.top
APP_VERSION=1.0.0
LOG_LEVEL=info

# AI personality — leave empty to use the built-in OmHackz prompt.
# Can also be edited live from the dashboard (Settings → Assistant).
AI_SYSTEM_PROMPT=
REPLY_SIGNATURE=Best regards,
OmHackz
support@omhackz.top

# -----------------------------------------------------------------------------
#  Limits
# -----------------------------------------------------------------------------
MAX_REPLIES_PER_SENDER_DAY=3
MAX_REPLIES_PER_DAY=25
MAX_EMAIL_BODY_CHARS=12000
MAX_AI_RESPONSE_CHARS=4000
MAX_WEBHOOK_BYTES=256000
MAX_RETRIES=3
MAX_CONVERSATION_REPLIES=1
ALLOW_MULTIPLE_REPLIES_PER_CONVERSATION=false

# -----------------------------------------------------------------------------
#  Identity — addresses and domains that are "us" (never auto-answered).
#  Comma separated.
# -----------------------------------------------------------------------------
SELF_DOMAINS=omhackz.top
SELF_ADDRESSES=support@omhackz.top

# Where escalations should be pointed. Comma separated. Empty = none.
ESCALATION_RECIPIENTS=

# -----------------------------------------------------------------------------
#  Safety — prompt-injection sensitivity: low | medium | high
#  Spam score is only read when DeoMail sends a spam-score header.
# -----------------------------------------------------------------------------
INJECTION_SENSITIVITY=medium
SPAM_SCORE_THRESHOLD=6
SPAM_SCORE_MAX=10

# -----------------------------------------------------------------------------
#  Persistent storage — Upstash Redis (serverless, free tier)
#  https://console.upstash.io → create a database → copy REST URL + token.
#  STORAGE_PROVIDER=memory is for local development only: it is not durable
#  and not shared between function instances.
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=redis
REDIS_PREFIX=ommail
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
#  Admin authentication — protects /api/admin/* and the dashboard at /
#  Generate: openssl rand -hex 32
# -----------------------------------------------------------------------------
ADMIN_SECRET=
ADMIN_RATE_LIMIT_PER_MINUTE=60
